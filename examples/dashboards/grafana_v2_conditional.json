{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "grafana-v2-conditional"
  },
  "spec": {
    "annotations": null,
    "cursorSync": "",
    "elements": {
      "errors": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Server errors (shown with data)",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(rate(prometheus_http_requests_total{code=~\"5..\"}[5m]))",
                        "legendFormat": "5xx"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": null
              }
            }
          }
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "id": 6,
          "title": "Resident memory",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "process_resident_memory_bytes",
                        "legendFormat": "{{job}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "bytes"
                },
                "overrides": null
              }
            }
          }
        }
      },
      "requests": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Requests",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(rate(prometheus_http_requests_total[5m]))",
                        "legendFormat": "requests"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": null
              }
            }
          }
        }
      },
      "scrape": {
        "kind": "Panel",
        "spec": {
          "id": 5,
          "title": "Scrape duration",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "scrape_duration_seconds",
                        "legendFormat": "{{job}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": null
              }
            }
          }
        }
      },
      "staging": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Staging targets",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "count(up)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {},
                "overrides": null
              }
            }
          }
        }
      },
      "targets": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Targets up",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum(up)"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {},
                "overrides": null
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Production ($env)",
              "conditionalRendering": {
                "kind": "ConditionalRenderingGroup",
                "spec": {
                  "visibility": "show",
                  "condition": "and",
                  "items": [
                    {
                      "kind": "ConditionalRenderingVariable",
                      "spec": {
                        "variable": "env",
                        "operator": "equals",
                        "value": "prod"
                      }
                    }
                  ]
                }
              },
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "maxColumnCount": 2,
                  "columnWidthMode": "",
                  "rowHeightMode": "short",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "requests"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "errors"
                        },
                        "conditionalRendering": {
                          "kind": "ConditionalRenderingGroup",
                          "spec": {
                            "visibility": "show",
                            "condition": "and",
                            "items": [
                              {
                                "kind": "ConditionalRenderingData",
                                "spec": {
                                  "value": true
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "targets"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Staging only",
              "conditionalRendering": {
                "kind": "ConditionalRenderingGroup",
                "spec": {
                  "visibility": "show",
                  "condition": "and",
                  "items": [
                    {
                      "kind": "ConditionalRenderingVariable",
                      "spec": {
                        "variable": "env",
                        "operator": "equals",
                        "value": "staging"
                      }
                    }
                  ]
                }
              },
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "staging"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Details",
              "layout": {
                "kind": "TabsLayout",
                "spec": {
                  "tabs": [
                    {
                      "kind": "TabsLayoutTab",
                      "spec": {
                        "title": "Overview",
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 24,
                                  "height": 6,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "memory"
                                  }
                                }
                              }
                            ]
                          }
                        }
                      }
                    },
                    {
                      "kind": "TabsLayoutTab",
                      "spec": {
                        "title": "Zoomed in (range ≤ 1h)",
                        "layout": {
                          "kind": "GridLayout",
                          "spec": {
                            "items": [
                              {
                                "kind": "GridLayoutItem",
                                "spec": {
                                  "x": 0,
                                  "y": 0,
                                  "width": 24,
                                  "height": 6,
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "scrape"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "conditionalRendering": {
                          "kind": "ConditionalRenderingGroup",
                          "spec": {
                            "visibility": "show",
                            "condition": "and",
                            "items": [
                              {
                                "kind": "ConditionalRenderingTimeRangeSize",
                                "spec": {
                                  "value": "1h"
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "links": null,
    "preload": false,
    "tags": null,
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "5s",
      "autoRefreshIntervals": null,
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Grafana V2 Conditional Rendering",
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "env",
          "query": "prod,staging",
          "current": {
            "text": "prod",
            "value": "prod"
          },
          "options": null,
          "multi": false,
          "includeAll": false,
          "hide": "",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      }
    ]
  }
}

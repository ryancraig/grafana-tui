              "width": 8,
              "height": 8,
              "element": {
                "kind": "ElementReference",
                "name": "panel-5"
              }
            }
          },
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 16,
              "y": 8,
              "width": 8,
              "height": 8,
              "element": {
                "kind": "ElementReference",

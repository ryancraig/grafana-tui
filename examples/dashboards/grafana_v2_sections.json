{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "grafana-v2-sections"
  },
  "spec": {
    "annotations": null,
    "cursorSync": "",
    "elements": {
      "handler": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Requests $handler",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "sum by (handler) (rate(prometheus_http_requests_total{handler=~\"$handler\"}[5m]))",
                        "legendFormat": "{{handler}}"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "reqps"
                },
                "overrides": null
              }
            }
          }
        }
      },
      "latency": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "p$quantile request latency",
          "links": null,
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "expr": "histogram_quantile($quantile, sum by (le) (rate(prometheus_http_request_duration_seconds_bucket[5m])))",
                        "legendFormat": "p$quantile"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": null,
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "",
            "spec": {
              "options": null,
              "fieldConfig": {
                "defaults": {
                  "unit": "s"
                },
                "overrides": null
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Dashboard quantile (p$quantile)",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "latency"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Tail latency (p$quantile)",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 24,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "latency"
                        }
                      }
                    }
                  ]
                }
              },
              "variables": [
                {
                  "kind": "CustomVariable",
                  "spec": {
                    "name": "quantile",
                    "query": "0.99,0.999",
                    "current": {
                      "text": "0.99",
                      "value": "0.99"
                    },
                    "options": null,
                    "multi": false,
                    "includeAll": false,
                    "hide": "",
                    "skipUrlSync": false,
                    "allowCustomValue": false
                  }
                }
              ]
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "title": "Busiest handlers",
              "layout": {
                "kind": "GridLayout",
                "spec": {
                  "items": [
                    {
                      "kind": "GridLayoutItem",
                      "spec": {
                        "x": 0,
                        "y": 0,
                        "width": 12,
                        "height": 6,
                        "element": {
                          "kind": "ElementReference",
                          "name": "handler"
                        },
                        "repeat": {
                          "mode": "variable",
                          "value": "handler",
                          "direction": "h",
                          "maxPerRow": 3
                        }
                      }
                    }
                  ]
                }
              },
              "variables": [
                {
                  "kind": "QueryVariable",
                  "spec": {
                    "name": "handler",
                    "current": {
                      "text": [
                        "All"
                      ],
                      "value": [
                        "$__all"
                      ]
                    },
                    "hide": "",
                    "refresh": "onDashboardLoad",
                    "skipUrlSync": false,
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "spec": {
                        "query": "label_values(prometheus_http_requests_total, handler)"
                      }
                    },
                    "regex": "/(\\/api\\/v1\\/.*)/",
                    "sort": "",
                    "definition": "label_values(prometheus_http_requests_total, handler)",
                    "options": null,
                    "multi": true,
                    "includeAll": true,
                    "allowCustomValue": false
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "links": null,
    "preload": false,
    "tags": null,
    "timeSettings": {
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "5s",
      "autoRefreshIntervals": null,
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "title": "Grafana V2 Section Variables",
    "variables": [
      {
        "kind": "CustomVariable",
        "spec": {
          "name": "quantile",
          "query": "0.5,0.9,0.99",
          "current": {
            "text": "0.9",
            "value": "0.9"
          },
          "options": null,
          "multi": false,
          "includeAll": false,
          "hide": "",
          "skipUrlSync": false,
          "allowCustomValue": false
        }
      }
    ]
  }
}
